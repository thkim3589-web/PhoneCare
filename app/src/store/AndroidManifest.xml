<?xml version="1.0" encoding="utf-8"?>
<!-- 플레이 스토어용: 스토어 정책상 필요 없는 권한 제거 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 스토어 앱은 스토어를 통해서만 업데이트 -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
    <!-- 배터리 최적화 제외는 '직접 요청' 대신 설정 화면 안내로 대체 -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="remove" />

    <!-- 알림 접근(개수 집계)은 플레이 스토어 버전에만 넣음.
         직접 설치(APK)에 이 기능이 있으면 Play Protect가 '유해 앱'으로 경고하기 때문 -->
    <application>
        <!-- 알림 많은 앱: 앱별 알림 '개수'만 셈 (내용은 읽지 않음) -->
        <service
            android:name=".service.NotifCounterService"
            android:exported="true"
            android:label="폰케어 알림 집계"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
